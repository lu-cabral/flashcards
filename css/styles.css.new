.group-actions {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    gap: 8px;
}

.edit-group-btn,
.delete-group-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 16px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: all 0.2s ease;
}

.edit-group-btn:hover {
    background: rgba(74, 144, 226, 0.1);
    color: var(--primary-color);
}

.delete-group-btn:hover {
    background: rgba(217, 83, 79, 0.1);
    color: #d9534f;
}

.edit-group-btn i,
.delete-group-btn i {
    font-size: 16px;
}